<?xml version="1.0" encoding="UTF-8"?>
<templates t-name="PaymentScreen" xml:space="preserve">
    <t t-name="PaymentScreenInherit"
       t-inherit="point_of_sale.PaymentScreen"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('top-content')]/div[hasclass('back')]" position="replace">
            <div class="button back"
                 t-on-click="() => this.onCustomBackClick()">
                <i class="fa fa-angle-double-left fa-fw"></i>
                <span class="back_text">Back</span>
            </div>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="PartnerLine"
        t-inherit="point_of_sale.PartnerLine"
        t-inherit-mode="extension"
    >
        <xpath expr="//td[hasclass('edit-partner-button-cell')]" position="after">
            <td class="esign">
                <t t-if="props.isWaitingForESign">
                    Waiting...
                </t>
                <t t-elif="!props.partner.sign_attachment_id">
                    <button
                        class="esign-button btn btn-light border"
                        t-on-click.stop="() => props.onClickESign(props.partner)"
                    >E-Sign</button>
                </t>
                <t
                    t-else=""
                    t-esc='!!(props.partner.sign_attachment_id) &amp;&amp; "&#10004;" || ""'
                />
            </td>
        </xpath>
    </t>
</templates>
